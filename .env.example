# Copy to .env and fill in for your environment. Never commit the real .env.
#
# This file lists every environment variable the application code
# actually reads (grep for os.environ/os.getenv across src/asavexa/ —
# see RUNTIME_REQUIREMENTS.md, Step 1, "Required environment
# variables"). Sections that would normally appear here for a typical
# web app but that this codebase has no variable for are still listed
# below, explicitly marked "not applicable", rather than silently
# omitted — so this file stays a complete map of the app's real
# configuration surface, not just its two currently-used keys.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# No general application-level variable exists (no APP_ENV/DEBUG/LOG_LEVEL
# flag in the code) — logging and exception handling in api/main.py are
# unconditional, not environment-gated.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Read by src/asavexa/api/db/base.py. Falls back to this same local-dev
# value if unset, so setting it explicitly matters only when pointing at
# a different host/db/credentials.
DATABASE_URL=postgresql+psycopg://asavexa:asavexa@localhost:5432/asavexa

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# No secret/key variable exists. Auth is real session-token based
# (see src/asavexa/api/deps.py), with opaque tokens generated and
# stored server-side in the real `sessions` table — not JWTs, so there
# is no signing secret to configure:
#   POST /auth/register  -> create a user
#   POST /auth/login     -> returns a bearer session token
#   POST /auth/select-organisation (with that token) -> binds the
#     session to one organisation; every org-scoped endpoint requires
#     this to have been called first
#   All other endpoints: send the token as `Authorization: Bearer <token>`
# There is no header-trusting fallback — every request is resolved
# through IdentityService.validate_session against a real Session
# record; an invalid/expired/revoked token gets 401, not silent trust.

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Read by src/asavexa/api/main.py's CORSMiddleware setup. Comma-separated
# list of origins allowed to call this API cross-origin. Only matters
# when the frontend is served from a different origin than the API —
# the docker-compose.yml setup avoids this entirely by reverse-proxying
# /api/* through the same nginx origin the frontend is served from.
# Never a wildcard; never combined with allow_credentials (this API has
# none — see docs/security-architecture.md).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Not applicable. Evidence Vault records are stored as rows in the real
# `evidence_records` table (metadata + hash) — there is no separate
# object-storage backend (S3-compatible or otherwise) integrated, so
# there is no bucket/endpoint/credential variable to set. See Phase 8's
# report: "separate 'UI capability implemented' from 'real storage
# runtime verified'" — this remains an explicit known limitation, not
# an oversight here.

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Not applicable. The frontend is zero-build, zero-npm-dependency
# vanilla JS (native ES modules) — it has no bundler and reads no
# environment variables of its own at build or run time. Its API base
# URL is a same-origin relative path ("/api"), fixed in
# frontend/src/api/client.js, not an injected variable.

# ---------------------------------------------------------------------------
# nginx
# ---------------------------------------------------------------------------
# Not applicable as an env var — nginx's behavior (the /api/ reverse
# proxy target, security headers, static-file serving) is fixed in the
# committed frontend/nginx.conf, not parameterized via environment
# variables, since docker-compose.yml's service name ("api") is a
# stable, known value at build time.

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Not applicable. api/main.py's request-logging middleware and
# exception handler (Phase 7) log unconditionally via Python's stdlib
# `logging` to stdout/stderr — there is no log level, log destination,
# or tracing/metrics-endpoint variable to configure.
